# Copy to .env.local and fill in. .env.local is gitignored; this example is not.

# Claude — equipment recognition, plan generation, meal/ingredient recognition,
# and the `images specs` step of scripts/images.ts.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Neon Postgres connection string (Neon dashboard -> Connection Details).
# Use the pooled/-pooler host if offered. There is no separate local database:
# local development talks to the same instance as production.
DATABASE_URL=

# Vercel Blob (dashboard -> Storage -> your Blob store -> .env.local tab).
# Needed explicitly for local dev and for scripts/images.ts; on Vercel it is
# injected automatically once the Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=

# OpenAI — ONLY for `npm run images generate`, which renders the exercise
# illustrations offline. The app itself never calls OpenAI, so do NOT add this
# to the Vercel project environment. See IMAGES.md.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
